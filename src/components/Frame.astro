---
type Props = {
    url: string;
    title?: string;
};

const { url, title = "YouTube video player" } = Astro.props;
---

<div class="relative overflow-hidden w-full aspect-video">
    <iframe
        src={url}
        title={title}
        loading="lazy"
        allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        class="absolute inset-0 border-0 w-full h-full"
    ></iframe>
</div>
