---
type Row = {
    name: string;
    before: number;
    after: number;
};

type Props = {
    title: string;
    caption: string;
    beforeLabel: string;
    afterLabel: string;
    unit: string;
    rows: Row[];
};

const { title, caption, beforeLabel, afterLabel, unit, rows } = Astro.props;

const max = Math.max(...rows.flatMap((r) => [r.before, r.after]));
const step = max > 200 ? 100 : 50;
const domain = Math.ceil(max / step) * step;
const ticks = Array.from({ length: domain / step + 1 }, (_, i) => i * step);

// Bars share the row with their value label, so the plot is the row minus label room.
const x = (v: number) => `calc((100% - var(--label-room)) * ${v / domain})`;
const speedup = (r: Row) => `${(r.before / r.after).toFixed(1)}×`;
---

<figure class="perf-chart not-prose my-8">
    <p class="text-neutral-50 font-medium">{title}</p>
    <div class="flex gap-5 pt-2 pb-4 text-sm text-neutral-300">
        <span class="flex items-center gap-2"><span class="swatch before"></span>{beforeLabel}</span>
        <span class="flex items-center gap-2"><span class="swatch after"></span>{afterLabel}</span>
    </div>
    <div class="plot" role="img" aria-label={`${title}. ${rows.map((r) => `${r.name}: ${r.before} to ${r.after} ${unit}`).join("; ")}`}>
        {ticks.map((t) => <span class="grid" style={`left: ${x(t)}`} />)}
        {
            rows.map((r) => (
                <div
                    class="row"
                    title={`${r.name}\n${beforeLabel}: ${r.before.toFixed(1)} ${unit}\n${afterLabel}: ${r.after.toFixed(1)} ${unit}\n${speedup(r)} faster`}
                >
                    <p class="name">{r.name}</p>
                    <div class="bar-line">
                        <span class="bar before" style={`width: ${x(r.before)}`} />
                        <span class="value">{r.before.toFixed(1)} {unit}</span>
                    </div>
                    <div class="bar-line">
                        <span class="bar after" style={`width: ${x(r.after)}`} />
                        <span class="value">
                            {r.after.toFixed(1)} {unit}
                            <strong class="speedup">{speedup(r)} faster</strong>
                        </span>
                    </div>
                </div>
            ))
        }
        <div class="axis">
            {ticks.map((t) => <span class="tick" style={`left: ${x(t)}`}>{t}</span>)}
        </div>
    </div>
    <figcaption class="pt-2 text-sm text-neutral-400">{caption}</figcaption>
    <details class="pt-2 text-sm text-neutral-400">
        <summary class="cursor-pointer hover:text-neutral-200">Show as table</summary>
        <table class="mt-2 w-full text-left">
            <thead class="text-neutral-300">
                <tr>
                    <th class="py-1 font-medium">Operation</th>
                    <th class="py-1 font-medium text-right">{beforeLabel} ({unit})</th>
                    <th class="py-1 font-medium text-right">{afterLabel} ({unit})</th>
                    <th class="py-1 font-medium text-right">Speedup</th>
                </tr>
            </thead>
            <tbody class="tabular-nums">
                {
                    rows.map((r) => (
                        <tr class="border-t border-neutral-800">
                            <td class="py-1 font-mono break-all">{r.name}</td>
                            <td class="py-1 text-right">{r.before.toFixed(1)}</td>
                            <td class="py-1 text-right">{r.after.toFixed(1)}</td>
                            <td class="py-1 text-right">{speedup(r)}</td>
                        </tr>
                    ))
                }
            </tbody>
        </table>
    </details>
</figure>

<style>
    .perf-chart {
        --series-1: #3987e5;
        --series-2: #d95926;
        --grid: #2e2e2c;
        --text-primary: #fafafa;
        --text-secondary: #c3c2b7;
        --text-muted: #8a8983;
        --label-room: 10rem;
    }
    .swatch {
        width: 10px;
        height: 10px;
        border-radius: 2px;
    }
    .before {
        background: var(--series-1);
    }
    .after {
        background: var(--series-2);
    }
    .plot {
        position: relative;
        padding-bottom: 1.75rem;
        border-left: 1px solid var(--text-muted);
    }
    .grid {
        position: absolute;
        top: 0;
        bottom: 1.75rem;
        width: 1px;
        background: var(--grid);
    }
    .row {
        position: relative;
        padding: 0.375rem 0 0.75rem;
    }
    .row:hover {
        background: rgb(255 255 255 / 0.04);
    }
    .name {
        padding-left: 0.5rem;
        padding-bottom: 0.25rem;
        color: var(--text-secondary);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.8125rem;
    }
    .row:hover .name {
        color: var(--text-primary);
    }
    .bar-line {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        height: 16px;
    }
    .bar-line + .bar-line {
        margin-top: 2px;
    }
    /* Square at the baseline, 4px rounded data end. */
    .bar {
        height: 16px;
        border-radius: 0 4px 4px 0;
    }
    .value {
        white-space: nowrap;
        color: var(--text-secondary);
        font-size: 0.75rem;
        font-variant-numeric: tabular-nums;
    }
    .speedup {
        margin-left: 0.375rem;
        color: var(--text-primary);
        font-weight: 600;
    }
    .axis {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 1.5rem;
    }
    .tick {
        position: absolute;
        bottom: 0;
        transform: translateX(-50%);
        color: var(--text-muted);
        font-size: 0.75rem;
    }
</style>
