---
// Horizontal bar chart. Each row either has one value (coloured by its series)
// or, with `stacked`, one value per series drawn as adjacent segments.
type Row = {
    name: string;
    values: number[];
    /** Series index for single-value rows. */
    series?: number;
};

type Props = {
    title: string;
    caption: string;
    unit: string;
    rows: Row[];
    series: string[];
    stacked?: boolean;
    decimals?: number;
    /** Optional vertical reference line, e.g. the card's total VRAM. */
    reference?: { value: number; label: string };
};

const { title, caption, unit, rows, series, stacked = false, decimals = 1, reference } = Astro.props;

const total = (r: Row) => r.values.reduce((a, b) => a + b, 0);
const fmt = (v: number) => v.toLocaleString("en-US", { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
const label = (v: number) => `${fmt(v)} ${unit}`;

const max = Math.max(...rows.map(total), reference?.value ?? 0);
const magnitude = 10 ** Math.floor(Math.log10(max));
const step = [1, 2, 2.5, 5, 10].map((m) => m * magnitude).find((s) => max / s <= 6) ?? magnitude * 10;
const domain = Math.ceil(max / step) * step;
const ticks = Array.from({ length: Math.round(domain / step) + 1 }, (_, i) => i * step);

// Bars share the row with their value label, so the plot is the row minus label room.
const x = (v: number) => `calc((100% - var(--label-room)) * ${v / domain})`;
const seriesOf = (r: Row) => r.series ?? 0;
const describe = (r: Row) =>
    stacked
        ? `${r.name}: ${r.values.map((v, i) => `${series[i]} ${label(v)}`).join(", ")}, total ${label(total(r))}`
        : `${r.name}: ${label(total(r))}`;
---

<figure class="bar-chart not-prose my-8">
    <p class="text-neutral-50 font-medium">{title}</p>
    {
        series.length > 1 && (
            <div class="flex flex-wrap gap-x-5 gap-y-1 pt-2 text-sm text-neutral-300">
                {series.map((s, i) => (
                    <span class="flex items-center gap-2">
                        <span class={`swatch s${i}`} />
                        {s}
                    </span>
                ))}
            </div>
        )
    }
    <div class="plot mt-4" role="img" aria-label={`${title}. ${rows.map(describe).join("; ")}`}>
        {ticks.map((t) => <span class="grid" style={`left: ${x(t)}`} />)}
        {
            reference && (
                <span class="reference" style={`left: ${x(reference.value)}`}>
                    <span class="reference-label">{reference.label}</span>
                </span>
            )
        }
        {
            rows.map((r) => (
                <div class="row" title={describe(r).replaceAll(", ", "\n")}>
                    <p class="name">{r.name}</p>
                    <div class="bar-line">
                        <span class="bars" style={`width: ${x(total(r))}`}>
                            {stacked ? (
                                r.values.map((v, i) => v > 0 && <span class={`bar s${i}`} style={`flex: ${v} 1 0`} />)
                            ) : (
                                <span class={`bar s${seriesOf(r)}`} style="flex: 1 1 0" />
                            )}
                        </span>
                        <span class="value">{label(total(r))}</span>
                    </div>
                </div>
            ))
        }
        <div class="axis">
            {ticks.map((t) => <span class="tick" style={`left: ${x(t)}`}>{t.toLocaleString("en-US")}</span>)}
        </div>
    </div>
    <figcaption class="pt-2 text-sm text-neutral-400">{caption}</figcaption>
    <details class="pt-2 text-sm text-neutral-400">
        <summary class="cursor-pointer hover:text-neutral-200">Show as table</summary>
        <table class="mt-2 w-full text-left">
            <thead class="text-neutral-300">
                <tr>
                    <th class="py-1 font-medium">Configuration</th>
                    {stacked && series.map((s) => <th class="py-1 font-medium text-right">{s} ({unit})</th>)}
                    <th class="py-1 font-medium text-right">{stacked ? "Total" : series.length > 1 ? "Model" : ""}</th>
                    {!stacked && <th class="py-1 font-medium text-right">{unit}</th>}
                </tr>
            </thead>
            <tbody class="tabular-nums">
                {
                    rows.map((r) => (
                        <tr class="border-t border-neutral-800">
                            <td class="py-1 font-mono break-all">{r.name}</td>
                            {stacked && r.values.map((v) => <td class="py-1 text-right">{fmt(v)}</td>)}
                            <td class="py-1 text-right">{stacked ? fmt(total(r)) : series.length > 1 ? series[seriesOf(r)] : ""}</td>
                            {!stacked && <td class="py-1 text-right">{fmt(total(r))}</td>}
                        </tr>
                    ))
                }
                {
                    reference && (
                        <tr class="border-t border-neutral-800">
                            <td class="py-1">{reference.label}</td>
                            {stacked && series.map(() => <td />)}
                            <td class="py-1 text-right">{stacked ? fmt(reference.value) : ""}</td>
                            {!stacked && <td class="py-1 text-right">{fmt(reference.value)}</td>}
                        </tr>
                    )
                }
            </tbody>
        </table>
    </details>
</figure>

<style>
    .bar-chart {
        /* Same validated pair as PerfChart, checked against the neutral-900 surface. */
        --series-0: #3987e5;
        --series-1: #d95926;
        --grid: #2e2e2c;
        --surface: #171717;
        --text-primary: #fafafa;
        --text-secondary: #c3c2b7;
        --text-muted: #8a8983;
        --label-room: 6.5rem;
    }
    .swatch {
        width: 10px;
        height: 10px;
        border-radius: 2px;
    }
    .s0 {
        background: var(--series-0);
    }
    .s1 {
        background: var(--series-1);
    }
    .plot {
        position: relative;
        padding-top: 1.25rem;
        padding-bottom: 1.75rem;
        border-left: 1px solid var(--text-muted);
    }
    .grid {
        position: absolute;
        top: 1.25rem;
        bottom: 1.75rem;
        width: 1px;
        background: var(--grid);
    }
    .reference {
        position: absolute;
        top: 0;
        bottom: 1.75rem;
        border-left: 2px dashed var(--text-muted);
    }
    .reference-label {
        position: absolute;
        top: 0;
        right: 0.375rem;
        white-space: nowrap;
        color: var(--text-secondary);
        font-size: 0.75rem;
        line-height: 1;
    }
    .row {
        position: relative;
        padding: 0.375rem 0 0.625rem;
    }
    .row:hover {
        background: rgb(255 255 255 / 0.04);
    }
    .name {
        padding-left: 0.5rem;
        padding-bottom: 0.25rem;
        color: var(--text-secondary);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.8125rem;
    }
    .row:hover .name {
        color: var(--text-primary);
    }
    .bar-line {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        height: 16px;
    }
    /* Segments sit 2px apart; square at the baseline, 4px rounded data end. */
    .bars {
        display: flex;
        gap: 2px;
        height: 16px;
        flex: none;
    }
    .bar {
        height: 16px;
        min-width: 2px;
    }
    .bar:last-child {
        border-radius: 0 4px 4px 0;
    }
    .value {
        white-space: nowrap;
        color: var(--text-secondary);
        font-size: 0.75rem;
        font-variant-numeric: tabular-nums;
    }
    .axis {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 1.5rem;
    }
    .tick {
        position: absolute;
        bottom: 0;
        transform: translateX(-50%);
        color: var(--text-muted);
        font-size: 0.75rem;
    }
</style>
