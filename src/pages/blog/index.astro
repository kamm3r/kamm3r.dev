---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getPublishedPosts } from "../../utils/posts";

const posts = await getPublishedPosts();
---

<Base
    title="Marco Kammer - Blog"
    description="Writing about tech, gamedev and the occasional odd ball topic."
>
    <h1
        class="pb-4 text-3xl font-bold tracking-tight md:text-5xl text-neutral-50"
    >
        Blog
    </h1>
    <p class="pb-4 text-neutral-400">
        {
            `I'm going to write mostly about tech and gamedev stuff but here and there an odd ball might come out.
            In total, I've written ${posts.length} articles on my blog.
            Use the search below to filter posts.`
        }
    </p>
    <div class="relative w-full pb-4">
        <input
            id="post-search"
            aria-label="Search articles"
            type="search"
            placeholder="Search articles"
            autocomplete="off"
            class="w-full px-4 py-2 pr-10 border rounded-md placeholder-neutral-400 border-neutral-950 focus:ring-neutral-500 focus:border-neutral-500 bg-neutral-800 text-neutral-200"
        />
        <svg
            class="absolute w-5 h-5 right-3 top-3 text-neutral-400 pointer-events-none"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width={2}
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
    </div>
    <h2
        class="pt-8 pb-4 text-2xl font-bold tracking-tight md:text-4xl text-neutral-50"
    >
        All Posts
    </h2>
    <ul id="post-list" class="flex flex-col gap-3 pb-16">
        {
            posts.map((post) => (
                <li data-search={`${post.data.title} ${post.data.description}`.toLowerCase()}>
                    <PostCard {post} showDescription />
                </li>
            ))
        }
    </ul>
    <p id="no-results" class="hidden pb-16 text-neutral-400" role="status">
        No posts found.
    </p>
</Base>

<script>
    const input = document.querySelector<HTMLInputElement>("#post-search")!;
    const items = document.querySelectorAll<HTMLLIElement>("#post-list > li");
    const empty = document.querySelector<HTMLParagraphElement>("#no-results")!;

    function filter() {
        const query = input.value.trim().toLowerCase();
        let visible = 0;
        for (const item of items) {
            const match = item.dataset.search!.includes(query);
            item.hidden = !match;
            if (match) visible++;
        }
        empty.classList.toggle("hidden", visible > 0);
    }

    input.addEventListener("input", filter);
    // Browsers can restore the field value on back navigation.
    filter();
</script>
