---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import profile from "../../assets/profile.jpg";
import { formatDate } from "../../utils/date";
import { getPublishedPosts } from "../../utils/posts";
import { readingTime } from "../../utils/readingTime";

type Neighbor = { id: string; title: string } | undefined;

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    // Newest first, so "previous" is the older post and "next" the newer one.
    const published = await getPublishedPosts();
    const toNeighbor = (post?: CollectionEntry<"blog">): Neighbor =>
        post && { id: post.id, title: post.data.title };

    return posts.map((post) => {
        const i = published.findIndex((p) => p.id === post.id);
        return {
            params: { slug: post.id },
            props: {
                post,
                previous: i === -1 ? undefined : toNeighbor(published[i + 1]),
                next: i === -1 ? undefined : toNeighbor(published[i - 1]),
            },
        };
    });
}
type Props = {
    post: CollectionEntry<"blog">;
    previous: Neighbor;
    next: Neighbor;
};

const { post, previous, next } = Astro.props;
const { Content } = await render(post);
const editUrl = `https://github.com/kamm3r/kamm3r.dev/edit/main/${post.filePath}`;
---

<Base
    title={post.data.title}
    description={post.data.description}
    image={post.data.cover}
    noindex={post.data.isDraft}
>
    {
        post.data.isDraft ? (
            <blockquote class="my-8 py-4 pl-4 bg-neutral-800 text-lg" role="alert">
                This post is a <em class="underline">draft</em>. If you're reading this,
                you're probably a cool and trusted person. Please{" "}
                <em class="underline">don't share</em> it thank you.
            </blockquote>
        ) : (
            <article class="flex flex-col items-start justify-center pb-16 w-full">
                <a href="/blog" class="mb-6 text-sm text-neutral-400 hover:text-neutral-100 transition-colors">
                    ← All posts
                </a>
                <h1 class="mb-4 text-3xl font-bold tracking-tight md:text-5xl text-neutral-50">
                    {post.data.title}
                </h1>
                <div class="flex flex-col items-start justify-between w-full mt-2 md:flex-row md:items-center">
                    <div class="flex items-center">
                        <Image
                            src={profile}
                            alt=""
                            width={24}
                            height={24}
                            densities={[1, 2]}
                            class="w-6 h-6 rounded-full"
                        />
                        <p class="ml-2 text-sm text-neutral-300">
                            {"Marco Kammer / "}
                            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                        </p>
                    </div>
                    <p class="mt-2 text-sm text-neutral-400 md:mt-0">
                        {readingTime(post.body)}
                    </p>
                </div>
                <div class="w-full max-w-none pt-4 pb-8 prose prose-neutral prose-invert md:prose-lg">
                    <Content />
                </div>
                {
                    (previous || next) && (
                        <nav aria-label="More posts" class="grid w-full gap-6 border-t border-neutral-800 pt-6 pb-8 sm:grid-cols-2">
                            {previous ? (
                                <a
                                    href={`/blog/${previous.id}`}
                                    class="group flex flex-col gap-1"
                                >
                                    <span class="text-sm text-neutral-500">← Previous</span>
                                    <span class="text-neutral-300 group-hover:text-neutral-50 transition-colors">{previous.title}</span>
                                </a>
                            ) : (
                                <span class="hidden sm:block" />
                            )}
                            {next && (
                                <a
                                    href={`/blog/${next.id}`}
                                    class="group flex flex-col gap-1 sm:text-right"
                                >
                                    <span class="text-sm text-neutral-500">Next →</span>
                                    <span class="text-neutral-300 group-hover:text-neutral-50 transition-colors">{next.title}</span>
                                </a>
                            )}
                        </nav>
                    )
                }
                <a
                    href={editUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm text-neutral-400 hover:text-neutral-100 transition-colors"
                >
                    Suggest a change on GitHub
                </a>
            </article>
        )
    }
</Base>

<script>
    for (const pre of document.querySelectorAll<HTMLPreElement>(".prose pre")) {
        const wrapper = document.createElement("div");
        wrapper.className = "code-block";
        pre.replaceWith(wrapper);
        wrapper.append(pre);

        const button = document.createElement("button");
        button.type = "button";
        button.className = "copy-code";
        button.textContent = "Copy";
        button.addEventListener("click", async () => {
            await navigator.clipboard.writeText(pre.innerText);
            button.textContent = "Copied";
            button.dataset.copied = "";
            setTimeout(() => {
                button.textContent = "Copy";
                delete button.dataset.copied;
            }, 1500);
        });
        wrapper.append(button);
    }
</script>
